# Android release signing — copy to android/key.properties and fill in.
# NEVER commit the real file (it is gitignored).
#
# Generate a keystore first:
#   keytool -genkey -v -keystore ~/fitflow-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=upload
storeFile=/absolute/path/to/fitflow-upload.jks
