# ─────────────────────────────────────────────────────────────────────────────
#  Dani Inmigración · configuration du serveur Live
#  Copier ce fichier en `.env` puis adapter. Toutes les variables sont optionnelles :
#  sans `.env`, le serveur démarre en local avec les valeurs par défaut ci-dessous.
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
# localhost = accessible uniquement depuis cet ordinateur.
# 0.0.0.0   = accessible depuis le réseau local (ex. tester la page /live sur un téléphone).
HOST=localhost
# URL utilisée dans les liens des emails (page du live, désinscription).
PUBLIC_URL=http://localhost:3000
# Dossier des données : base SQLite, enregistrements vidéo, emails de test.
DATA_DIR=storage
# true uniquement derrière un reverse proxy (nginx, Render…) qui transmet X-Forwarded-For.
TRUST_PROXY=false
# Live sur son propre sous-domaine (ex. https://live.daniinmigracion.com) :
# adresse du site principal. La racine « / » y redirige et ce site peut appeler
# l'API publique (bouton LIVE + formulaire d'inscription intégrés au site).
MAIN_SITE_URL=
# Autres origines autorisées à utiliser l'API publique (séparées par des virgules).
ALLOWED_ORIGINS=

# ── Cockpit (/cockpit) ───────────────────────────────────────────────────────
# Compte créé au PREMIER démarrage (mot de passe stocké hashé avec bcrypt).
# Pour le changer ensuite : npm run cockpit:password -- "nouveau-mot-de-passe"
ADMIN_USERNAME=dani
ADMIN_PASSWORD=daniinmigracion
SESSION_TTL_HOURS=12
# auto = cookie « Secure » dès que le site est servi en HTTPS ; true / false pour forcer.
COOKIE_SECURE=auto

# ── Emails ───────────────────────────────────────────────────────────────────
# console : AUCUN email réel. Chaque email est affiché dans le terminal et
#           enregistré en .eml dans storage/mails/ (idéal pour tester en local).
# smtp    : envoi réel via le serveur SMTP ci-dessous.
MAIL_MODE=console
MAIL_FROM="Dani Inmigración <no-reply@daniinmigracion.com>"
MAIL_RATE_PER_SECOND=5

# Exemple Mailtrap (boîte de test : les emails sont capturés, jamais délivrés)
# → https://mailtrap.io  > Email Testing > Inboxes > SMTP Settings
# MAIL_MODE=smtp
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=votre_user_mailtrap
# SMTP_PASS=votre_mot_de_passe_mailtrap

# Exemple Brevo / OVH / Gmail (envoi réel)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# (SMTP_SECURE=true uniquement pour le port 465)
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...

# ── Rappels automatiques (3 h et 5 min avant le live) ────────────────────────
REMINDERS_ENABLED=true
REMINDER_CHECK_SECONDS=30
# Fuseau horaire affiché dans les emails (le site affiche l'heure locale du visiteur).
SITE_TIMEZONE=Europe/Madrid

# ── Live (vidéo WebRTC) ──────────────────────────────────────────────────────
# Nombre max de viewers simultanés (diffusion « mesh » depuis le navigateur de Dani :
# compter ~1,5 Mbit/s d'upload par viewer).
MAX_VIEWERS=50
# Connexions simultanées max depuis une même IP publique (anti-accaparement des places).
MAX_VIEWERS_PER_IP=5
# Si la caméra de Dani se déconnecte, le live reste ouvert ce nombre de secondes.
LIVE_GRACE_SECONDS=180
# Un live programmé jamais démarré est marqué « non réalisé » après ce délai.
LIVE_MISSED_AFTER_MINUTES=120
# Serveurs STUN/TURN. Vide = suffisant pour localhost et le réseau local.
# Exemple : ICE_SERVERS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
ICE_SERVERS=
# Relais TURN de Cloudflare (recommandé en ligne : vidéo garantie même en 4G ou
# derrière un réseau d'entreprise). Cloudflare → Realtime → TURN Server → Create.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ── Géolocalisation des viewers (ville / pays) ───────────────────────────────
# ipapi  : ipapi.co (HTTPS, ~1000 requêtes/jour gratuites)
# ip-api : ip-api.com (HTTP, gratuit pour un usage non commercial)
# none   : désactivée
# En local, les viewers apparaissent « Local (este equipo) » ou « Red local ».
GEO_PROVIDER=ipapi
