{
  "name": "daniinmigracion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Live de Dani Inmigración (Cloudflare Workers): cockpit, inscripciones, recordatorios por email y grabaciones",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite",
    "dev:site": "node scripts/dev-site.mjs",
    "site:integrate": "node scripts/integrate-site.mjs",
    "site:deploy": "node scripts/deploy-site.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "deploy": "npm run build && wrangler deploy",
    "cockpit:password": "node scripts/cockpit-password.mjs",
    "build:demo": "vite build --config vite.demo.config.js"
  },
  "dependencies": {
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "worker-mailer": "^1.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22"
  }
}
