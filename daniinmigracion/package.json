{
  "name": "daniinmigracion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio Dani Inmigración (mobile-first) con lives en directo: cockpit, inscripciones, recordatorios por email y grabaciones",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "preview": "vite build && node server/index.js --prod",
    "cockpit:password": "node server/scripts/set-password.js",
    "build:demo": "vite build --config vite.demo.config.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.408.0",
    "nodemailer": "^10.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  }
}
